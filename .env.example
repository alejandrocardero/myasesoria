# ============================================
# MyAsesorIA Hub — Configuración de Entorno
# ============================================
# Copia este archivo como .env.local y edítalo:
#   cp .env.example .env.local
# ============================================

# --- PROVEEDOR DE IA ---
# Elige el backend de inteligencia artificial.
# Opciones: "ollama" (local, recomendado) | "gemini" (cloud)
AI_PROVIDER="ollama"

# --- OLLAMA (IA LOCAL) ---
# Requiere tener Ollama instalado y corriendo.
# Descargar: https://ollama.com/download
# Modelos recomendados: llama3, mistral, qwen2.5, deepseek-coder
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3"

# --- GEMINI (IA CLOUD) ---
# Solo necesario si AI_PROVIDER="gemini".
# Obtén tu API key en: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# --- URL DE LA APP ---
# Usada para enlaces internos. En desarrollo local dejar como está.
APP_URL="http://localhost:3000"
